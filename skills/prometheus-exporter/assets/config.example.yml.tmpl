# Example configuration file for @@EXPORTER_NAME@@.
#
# This file has no effect on its own. --config.file defaults to empty, so
# nothing here is read unless you start the exporter with:
#
#   ./@@EXPORTER_NAME@@ --config.file=/path/to/your-config.yml
#
# Copy this file, edit the copy, and point --config.file at it; nothing
# scans for a config file automatically.
#
# --config.file is not --web.config.file. This file (config.file) configures
# what the exporter does: which flags get which values, and how it
# authenticates to whatever it queries. --web.config.file is a separate flag,
# from prometheus/exporter-toolkit, that configures the TLS/Basic Auth the
# exporter's own HTTP server presents to Prometheus. Mixing the two up means
# looking in the wrong file when either side misbehaves.
#
# The file has two sections, and one rule decides which a setting belongs to:
# anything a command-line flag can already express goes under "flags:",
# keyed by the flag's own long name, without the leading "--". Anything a
# flag cannot express, such as authentication or TLS for the requests an
# HTTP-flavor exporter makes outward, gets its own section instead
# (http_client_config: below). No setting is ever expressible in both
# places, so a value never has two conflicting sources.
#
# Precedence, highest wins: command-line flag, then this file, then the
# process environment, then the flag's own built-in default. In particular,
# a value set here is overridden by the same flag passed on the command
# line, and this file itself sits above the environment, not below it.
#
# Paths written inside this file, such as password_file below or
# tls_config's ca_file/cert_file/key_file, resolve relative to this file's
# own location, not to the exporter's working directory. Prefer a *_file
# form over an inline value for any secret (password_file over password,
# for example) so the secret itself never has to live in this file.

flags:
  # A plain scalar: one value for the flag.
  log.level: info

  # A bool must be written as a YAML boolean (true/false), not a quoted
  # string. Watch out for the reverse case, though: this parser reads YAML
  # 1.1, so an UNQUOTED yes, no, on, or off also resolves to a boolean. If a
  # flag takes a string value that happens to be one of those words, quote
  # it (log.level: "on") to keep it a string.
  web.disable-exporter-metrics: false

  # A repeatable flag becomes a YAML list, one entry per repetition on the
  # command line. web.listen-address defaults to a single address; listing
  # two here binds both instead of just the second one. Pick addresses that
  # do not overlap: on Linux, a wildcard address already covers both IPv4
  # and IPv6 on the same port, so also listing an explicit ::1 on that same
  # port fails to bind. The second entry below deliberately sits well outside
  # the 9100 to 9999 range exporters draw their default port from, so it
  # cannot collide with the first whatever port this exporter was built with.
  web.listen-address:
    - ":@@DEFAULT_PORT@@"
    - "127.0.0.1:19101"

  # A collector's own flags follow the same rule as any built-in flag.
  # @@IF target-model=multi@@
  # This build declares no collector.example.* flags at all: its target
  # arrives per request on /probe rather than from a flag, so there is
  # nothing to set here.
  # @@ENDIF@@
  # @@IF target-model!=multi@@
  # Commented out rather than active because an example pointing at a value
  # you have not chosen is worse than no example. Uncomment and adapt.
  # collector.example.timeout: 10s
  # @@ENDIF@@

  # @@IF target-model!=multi@@
  # Bounds how many outbound requests/commands this exporter has in flight
  # at once. 0 (the default) means unlimited. See docs/configuration.md's
  # "Bounding outbound concurrency" section for what this bounds on this
  # build.
  # exporter.max-requests-per-target: 4
  # @@ENDIF@@

# @@IF flavor=http@@
# http_client_config carries the authentication and TLS settings no flag can
# express, and applies to this exporter's outbound requests.
# @@ENDIF@@
# @@IF flavor!=http@@
# http_client_config carries authentication and TLS for an HTTP-flavor
# exporter's outbound requests. This build runs a local command instead, so it
# has nothing to authenticate: given this section it refuses to start rather
# than accept a setting it would silently drop, so no example is shown here.
# @@ENDIF@@
# @@IF flavor=http@@
#
# Commented out here on purpose: an active block pointing at password_file/
# ca_file/cert_file/key_file paths that do not exist on your machine would
# fail --config.file loading outright, which is the last thing an example
# meant to be copied and tried should do. Uncomment it and point the paths
# at your own files to use it.
#
# This section is a prometheus/common HTTPClientConfig, so every key that
# library accepts works here even when it is not shown below. The two worth
# knowing about are spelled out: proxy_url, because nothing else in this
# exporter reveals that it exists, and insecure_skip_verify, because what it
# concedes is not obvious from its name.
#
# http_client_config:
#   basic_auth:
#     username: monitoring
#     password_file: /etc/@@EXPORTER_NAME@@/basic_auth_password
#
#   # Route outbound requests through a proxy. These keys sit here, next to
#   # tls_config rather than inside it.
#   #
#   # Read this even if you need no proxy, because declaring this section at
#   # all is what changes the behaviour. With NO http_client_config section,
#   # the exporter builds its client on Go's default transport and therefore
#   # DOES honour HTTP_PROXY/HTTPS_PROXY/NO_PROXY from the environment. The
#   # moment this section exists, for any reason whatsoever, including
#   # basic_auth on its own, the transport is rebuilt from what is written
#   # here, and the only proxy it can use is the one these two keys name. An
#   # environment proxy that was working simply stops being read, with no
#   # error and no log line.
#   #
#   # So if you add this section and your traffic has to cross a proxy,
#   # uncomment exactly one of the two below. They are mutually exclusive and
#   # the file is refused outright if both are set.
#   # proxy_url: http://proxy.example.internal:3128
#   # proxy_from_environment: true   # re-read HTTP_PROXY/HTTPS_PROXY/NO_PROXY
#
#   tls_config:
#     ca_file: /etc/@@EXPORTER_NAME@@/ca.crt
#     cert_file: /etc/@@EXPORTER_NAME@@/client.crt
#     key_file: /etc/@@EXPORTER_NAME@@/client.key
#     server_name: example.internal
#
#     # true turns off verification of the target's certificate entirely:
#     # any certificate is accepted, from anyone, so an intercepted
#     # connection is indistinguishable from a good one. It is a risk you
#     # accept, not a setting you tune, and it belongs in your own change
#     # record with the reason and the plan to remove it.
#     #
#     # The usual reason for reaching for it is a target certificate with no
#     # subjectAltName, which no Go client can verify by name since Go 1.15
#     # removed the fallback to the Common Name. Neither ca_file nor
#     # server_name helps there: the trust chain was never the problem and
#     # there is no name to match, so both leave the same error. The fix that
#     # actually closes it is on the target, by reissuing the certificate
#     # with a SAN. docs/validation-checklist.md carries the diagnosis steps,
#     # including why a successful curl does not predict a working Go client.
#     insecure_skip_verify: false
# @@ENDIF@@

# @@IF target-model=single@@
# modules: named credential/TLS bundles. This build refuses this section at
# boot, so no example is shown here: an example you cannot use is
# indistinguishable, on a first reading, from one you can. The other two
# target models are where it applies.
# @@ENDIF@@
# @@IF target-model!=single@@
# modules: named credential/TLS bundles this exporter can select. How a
# module gets picked depends on the target model this exporter was
# scaffolded with:
#
# @@ENDIF@@
# @@IF target-model=multi@@
# This build (/probe) selects a module per request with
# /probe?target=...&module=...; a module may carry both a collectors: subset
# and an http_client_config:.
# @@ENDIF@@
# @@IF target-model=multi-instance@@
# This build has each instances: entry reference a module by name in its own
# module: key (see docs/configuration.md), resolved once at boot rather than
# per request. A module's collectors: key is REFUSED here: collector
# enablement is global via --[no-]collector.<name> instead, so a per-module
# subset would be meaningless.
# @@ENDIF@@
# @@IF target-model!=single@@
#
# @@ENDIF@@
# @@IF target-model=multi@@
# Credentials never combine: at most
# one of the modules a request selects may carry an http_client_config:, and
# naming two is refused with a 400 rather than resolved by a precedence
# nobody wrote. A module that lists no collectors contributes only its
# credentials, which is what lets a credentials module be combined with
# collector modules.
#
# This section and the top-level http_client_config: above cannot both be
# set: with modules declared, nothing reads the top-level one.
# @@ENDIF@@
# @@IF target-model=multi-instance@@
# This section and the top-level http_client_config: above may both be
# present, but the top-level one then goes unread, since every instance
# resolves its module by name. A known asymmetry, not something to rely on.
# @@ENDIF@@
# @@IF target-model!=single@@
#
# Commented out for the same reason as http_client_config: above, an active
# block pointing at files that do not exist on your machine would fail to load.
#
# @@ENDIF@@
# @@IF target-model=multi@@
# Two conventions work, and the choice is yours to make here rather than in
# code, so it is reversible without regenerating anything.
#
# Convention 1, one module per group of targets, each a complete bundle:
#
# modules:
#   prod:
#     collectors: [example]
#     http_client_config:
#       basic_auth:
#         username: monitoring
#         password_file: /etc/@@EXPORTER_NAME@@/prod_password
#   staging:
#     collectors: [example]
#     http_client_config:
#       basic_auth:
#         username: monitoring
#         password_file: /etc/@@EXPORTER_NAME@@/staging_password
#
#   Scraped with: /probe?target=...&module=prod
#
# Convention 2, credentials and collector subsets as independent axes:
#
# modules:
#   default:
#     http_client_config:
#       basic_auth:
#         username: monitoring
#         password_file: /etc/@@EXPORTER_NAME@@/password
#   quick:
#     collectors: [example]
#
#   Scraped with: /probe?target=...&module=quick
#   (the default module supplies the credentials; naming it is optional)
# @@ENDIF@@
# @@IF target-model=multi-instance@@
# A module here is credentials and TLS only. No collectors: key: this build
# enables collectors globally with --[no-]collector.<name>, and a module that
# carries one is refused at boot.
#
# modules:
#   prod:
#     http_client_config:
#       basic_auth:
#         username: monitoring
#         password_file: /etc/@@EXPORTER_NAME@@/prod_password
#   lab:
#     http_client_config:
#       tls_config:
#         ca_file: /etc/@@EXPORTER_NAME@@/lab-ca.pem
# @@ENDIF@@

# @@IF target-model=multi-instance@@
# instances: the list of machines this exporter watches. REQUIRED on this
# target model, and the reason --config.file is mandatory here: the binary
# refuses to start without this file, because this list is what it would
# otherwise have nothing to poll.
#
# Uncomment and adapt. Each entry needs a unique name and an address; module:
# is optional and names an entry from modules: above. The name becomes the
# value of this exporter's identifying label (@@INSTANCE_LABEL@@) on every
# series that instance produces, so choose names you are willing to see in
# Grafana and in alert annotations, and do not rename them casually: renaming
# one breaks continuity of its series exactly as relabelling would.
#
# instances:
#   - name: machine-a
#     address: https://machine-a.example:8443
#   - name: machine-b
#     address: https://machine-b.example:8443
#   - name: lab-1
#     address: https://lab-1.example:8443
#
# No module: key above, deliberately. Uncommenting this block alone must give
# you a file that loads: add `module: <name>` to an entry only once you have
# also uncommented a modules: section declaring that name, or the exporter
# refuses to start with "references module ... but the config declares no
# modules". An example whose only working form is one nobody described is not
# an example.
#
# Two entries may name the same physical machine: they are then watched, and
# rate-limited, independently. See docs/configuration.md's
# "Bounding outbound concurrency" for what that costs.
# @@ENDIF@@
