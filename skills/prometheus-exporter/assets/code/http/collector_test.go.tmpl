// TestParseExample exercises parseExample (piece 2, the pure parser) with a
// static byte fixture: no HTTP, no collector, no logger involved.
func TestParseExample(t *testing.T) {
	data, err := os.ReadFile("testdata/example.json")
	if err != nil {
		t.Fatalf("read fixture: %v", err)
	}

	stats, err := parseExample(data)
	if err != nil {
		t.Fatalf("parseExample: %v", err)
	}
	if stats.Items != 42 {
		t.Errorf("Items = %d, want 42", stats.Items)
	}
	if !stats.Healthy {
		t.Error("Healthy = false, want true")
	}

	t.Run("malformed input yields an error, not a panic", func(t *testing.T) {
		if _, err := parseExample([]byte("not json")); err == nil {
			t.Error("parseExample(malformed) returned a nil error, want non-nil")
		}
	})
}

// TestExampleCollector_Collect drives the whole 5-piece collector through an
// httptest.Server standing in for the real target, then verifies both the
// metric count and their exact exposition-format output.
func TestExampleCollector_Collect(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		http.ServeFile(w, r, "testdata/example.json")
	}))
	defer srv.Close()

	log := logger.NewTextLogger("error")
	c := NewExampleCollector(context.Background(), log, NewClient(srv.URL, time.Second))

	reg := prometheus.NewRegistry()
	if err := reg.Register(c); err != nil {
		t.Fatalf("Register: %v", err)
	}

	count, err := testutil.GatherAndCount(reg)
	if err != nil {
		t.Fatalf("GatherAndCount: %v", err)
	}
	if count != 2 {
		t.Fatalf("GatherAndCount = %d, want 2", count)
	}

	expected := `
# HELP @@NAMESPACE@@_items Number of items reported by the example target.
# TYPE @@NAMESPACE@@_items gauge
@@NAMESPACE@@_items 42
# HELP @@NAMESPACE@@_healthy Whether the example target reports itself healthy (1) or not (0).
# TYPE @@NAMESPACE@@_healthy gauge
@@NAMESPACE@@_healthy 1
`
	if err := testutil.CollectAndCompare(c, strings.NewReader(expected)); err != nil {
		t.Fatalf("unexpected collecting result:\n%s", err)
	}
}

// TestExampleCollector_Describe locks the descriptor count at exactly 2
// (items, healthy) so a future edit that silently adds or drops a metric is
// caught here rather than downstream.
func TestExampleCollector_Describe(t *testing.T) {
	log := logger.NewTextLogger("error")
	c := NewExampleCollector(context.Background(), log, NewClient("http://example.invalid", time.Second))

	ch := make(chan *prometheus.Desc, 10)
	c.Describe(ch)
	close(ch)

	count := 0
	for range ch {
		count++
	}
	if count != 2 {
		t.Fatalf("Describe sent %d descriptors, want 2", count)
	}
}

// TestExampleCollector_ErrorHandling covers both a live-but-failing target
// (HTTP 500) and an unreachable one (connection refused). Either way Collect
// must emit zero metrics and must not panic: this is the contract the
// StatusTracker relies on to mark a collector's scrape as failed.
func TestExampleCollector_ErrorHandling(t *testing.T) {
	assertZeroMetrics := func(t *testing.T, target string) {
		t.Helper()
		log := logger.NewTextLogger("error")
		c := NewExampleCollector(context.Background(), log, NewClient(target, time.Second))

		reg := prometheus.NewRegistry()
		if err := reg.Register(c); err != nil {
			t.Fatalf("Register: %v", err)
		}

		count, err := testutil.GatherAndCount(reg)
		if err != nil {
			t.Fatalf("GatherAndCount: %v", err)
		}
		if count != 0 {
			t.Fatalf("GatherAndCount = %d, want 0", count)
		}
	}

	t.Run("server returns 500", func(t *testing.T) {
		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.WriteHeader(http.StatusInternalServerError)
		}))
		defer srv.Close()
		assertZeroMetrics(t, srv.URL)
	})

	t.Run("server unreachable", func(t *testing.T) {
		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
		srv.Close() // closed before use: every request now fails with connection refused
		assertZeroMetrics(t, srv.URL)
	})
}

// statusTrackerSuccessMetric is the collector_success metric family name,
// shared by the two StatusTracker tests below both as their
// testutil.CollectAndCompare filter and inside their own expected-text
// literals. Filtering to just this family deliberately excludes
// collector_duration_seconds from both comparisons: its value is a real
// elapsed time and therefore not deterministic.
const statusTrackerSuccessMetric = "@@NAMESPACE@@_exporter_collector_success"

// TestExampleCollector_StatusTrackerSuccess wraps a healthy ExampleCollector
// (live target, valid response) in a StatusTracker and asserts it is
// reported successful. Read together with
// TestExampleCollector_StatusTrackerFailure below, this pins down both
// directions of the count-based contract: metrics emitted means success,
// zero metrics means failure, regardless of whether anything panicked.
func TestExampleCollector_StatusTrackerSuccess(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		http.ServeFile(w, r, "testdata/example.json")
	}))
	defer srv.Close()

	log := logger.NewTextLogger("error")
	c := NewExampleCollector(context.Background(), log, NewClient(srv.URL, time.Second))

	tracker := NewStatusTracker(log)
	tracker.Add("example", c)

	expected := `
# HELP ` + statusTrackerSuccessMetric + ` Whether the last scrape of the collector succeeded (1=success, 0=failure)
# TYPE ` + statusTrackerSuccessMetric + ` gauge
` + statusTrackerSuccessMetric + `{collector="example"} 1
`
	if err := testutil.CollectAndCompare(tracker, strings.NewReader(expected), statusTrackerSuccessMetric); err != nil {
		t.Fatalf("unexpected collecting result:\n%s", err)
	}
}

// TestExampleCollector_StatusTrackerFailure wraps an ExampleCollector pointed
// at an unreachable target (so Collect logs an error and bare-returns, per
// its documented error path, see collector.go's Collect) in a StatusTracker
// and asserts the collector is reported UNsuccessful, even though nothing
// panicked. Before the count-based fix, StatusTracker only flipped success
// to 0 on a recovered panic, so a plain log-and-return error path like
// ExampleCollector's left it reporting success=1 with zero metrics
// published. This test fails against that pre-fix StatusTracker (RED) and
// passes once Collect counts emitted metrics instead (GREEN).
func TestExampleCollector_StatusTrackerFailure(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
	srv.Close() // closed before use: every request now fails with connection refused

	log := logger.NewTextLogger("error")
	c := NewExampleCollector(context.Background(), log, NewClient(srv.URL, time.Second))

	tracker := NewStatusTracker(log)
	tracker.Add("example", c)

	expected := `
# HELP ` + statusTrackerSuccessMetric + ` Whether the last scrape of the collector succeeded (1=success, 0=failure)
# TYPE ` + statusTrackerSuccessMetric + ` gauge
` + statusTrackerSuccessMetric + `{collector="example"} 0
`
	if err := testutil.CollectAndCompare(tracker, strings.NewReader(expected), statusTrackerSuccessMetric); err != nil {
		t.Fatalf("unexpected collecting result:\n%s", err)
	}
}

// TestRequestDuration_CustomRegistryReachable locks the other Critical fix:
// RequestDuration must be a plain, exported *prometheus.HistogramVec that
// this exporter's own custom registry can register directly (the same way
// registry.frag's injected register("http_client_requests", ...) call does
// in main.go), not a promauto value reachable only from
// prometheus.DefaultRegisterer. Before the fix, promauto.NewHistogramVec
// self-registered into that process-wide default registerer as a side
// effect of package init: reachable from prometheus.DefaultGatherer, but
// invisible to the custom registry main.go actually serves at /metrics.
func TestRequestDuration_CustomRegistryReachable(t *testing.T) {
	RequestDuration.WithLabelValues("success").Observe(0.01)

	reg := prometheus.NewRegistry()
	if err := reg.Register(RequestDuration); err != nil {
		t.Fatalf("Register(RequestDuration) on a fresh custom registry: %v", err)
	}
	count, err := testutil.GatherAndCount(reg, "@@NAMESPACE@@_exporter_request_duration_seconds")
	if err != nil {
		t.Fatalf("GatherAndCount(custom registry): %v", err)
	}
	if count == 0 {
		t.Fatal("GatherAndCount(custom registry) = 0, want >= 1: RequestDuration did not reach a registry it was explicitly registered on")
	}

	dcount, err := testutil.GatherAndCount(prometheus.DefaultGatherer, "@@NAMESPACE@@_exporter_request_duration_seconds")
	if err != nil {
		t.Fatalf("GatherAndCount(DefaultGatherer): %v", err)
	}
	if dcount != 0 {
		t.Fatalf("GatherAndCount(DefaultGatherer) = %d, want 0: RequestDuration must not self-register into the process-wide default registerer (that was the pre-fix bug: promauto.NewHistogramVec auto-registers there, a registry main.go's own /metrics handler never gathers)", dcount)
	}
}

func TestNewClientWithConfigAppliesBasicAuth(t *testing.T) {
	var gotUser, gotPass string
	var gotOK bool
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		gotUser, gotPass, gotOK = r.BasicAuth()
		w.WriteHeader(http.StatusOK)
		_, _ = w.Write([]byte("{}"))
	}))
	defer srv.Close()

	cfg := promconfig.HTTPClientConfig{
		BasicAuth: &promconfig.BasicAuth{Username: "monitor", Password: "hunter2"},
	}
	c, err := NewClientWithConfig(srv.URL, time.Second, cfg)
	if err != nil {
		t.Fatalf("NewClientWithConfig: %v", err)
	}
	if _, err := c.Fetch(context.Background(), "/"); err != nil {
		t.Fatalf("Fetch: %v", err)
	}

	if !gotOK {
		t.Fatal("the request carried no basic auth header")
	}
	if gotUser != "monitor" || gotPass != "hunter2" {
		t.Errorf("credentials = %q/%q, want monitor/hunter2", gotUser, gotPass)
	}
}

func TestNewClientWithConfigRejectsAnUnreadableCA(t *testing.T) {
	cfg := promconfig.HTTPClientConfig{
		TLSConfig: promconfig.TLSConfig{CAFile: "/nonexistent/ca.pem"},
	}
	if _, err := NewClientWithConfig("https://example.invalid", time.Second, cfg); err == nil {
		t.Fatal("NewClientWithConfig accepted a CA file that cannot be read")
	}
}
