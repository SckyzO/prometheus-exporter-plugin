// TestNilLimiterIsPassThrough pins the default: no ceiling configured,
// NewLimiter returns nil for any non-positive limit, and a nil *Limiter must
// cost nothing and never block.
func TestNilLimiterIsPassThrough(t *testing.T) {
	var l *Limiter
	if NewLimiter(0) != nil {
		t.Fatal("NewLimiter(0) returned a limiter; 0 must mean unlimited")
	}
	if NewLimiter(-1) != nil {
		t.Fatal("NewLimiter(-1) returned a limiter; a non-positive ceiling must mean unlimited")
	}
	release, err := l.Acquire(context.Background())
	if err != nil {
		t.Fatalf("nil limiter refused an acquisition: %v", err)
	}
	release()
}

// TestLimiterEnforcesItsCeiling proves the third caller waits while two hold
// slots, and proceeds as soon as one is released.
func TestLimiterEnforcesItsCeiling(t *testing.T) {
	l := NewLimiter(2)

	r1, err := l.Acquire(context.Background())
	if err != nil {
		t.Fatalf("first acquire: %v", err)
	}
	r2, err := l.Acquire(context.Background())
	if err != nil {
		t.Fatalf("second acquire: %v", err)
	}

	third := make(chan struct{})
	go func() {
		r3, err := l.Acquire(context.Background())
		if err == nil {
			r3()
		}
		close(third)
	}()

	select {
	case <-third:
		t.Fatal("the third acquire proceeded while both slots were held")
	case <-time.After(50 * time.Millisecond):
	}

	r1()
	select {
	case <-third:
	case <-time.After(2 * time.Second):
		t.Fatal("the third acquire did not proceed after a slot was released")
	}
	r2()
}

// TestLimiterAcquireHonoursContext is the property that keeps a ceiling from
// degrading silently: a starved caller fails on its own deadline instead of
// queueing forever while its ticker drops ticks.
func TestLimiterAcquireHonoursContext(t *testing.T) {
	l := NewLimiter(1)
	release, err := l.Acquire(context.Background())
	if err != nil {
		t.Fatalf("first acquire: %v", err)
	}
	defer release()

	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
	defer cancel()
	if _, err := l.Acquire(ctx); err == nil {
		t.Fatal("Acquire returned success on an expired context while the only slot was held")
	}
}

// TestLimiterReleaseIsSafeUnderConcurrency runs the ceiling under -race with
// more callers than slots, and asserts the ceiling was never exceeded.
func TestLimiterReleaseIsSafeUnderConcurrency(t *testing.T) {
	const ceiling = 3
	l := NewLimiter(ceiling)

	var mu sync.Mutex
	inFlight, peak := 0, 0

	var wg sync.WaitGroup
	for i := 0; i < 50; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			release, err := l.Acquire(context.Background())
			if err != nil {
				t.Errorf("acquire: %v", err)
				return
			}
			mu.Lock()
			inFlight++
			if inFlight > peak {
				peak = inFlight
			}
			mu.Unlock()

			time.Sleep(time.Millisecond)

			mu.Lock()
			inFlight--
			mu.Unlock()
			release()
		}()
	}
	wg.Wait()

	if peak > ceiling {
		t.Fatalf("peak concurrency was %d, ceiling is %d", peak, ceiling)
	}
	if peak == 0 {
		t.Fatal("no goroutine was ever observed in flight; the test proved nothing")
	}
}

// requestWaitSampleCount reads RequestWait's current sample count for one
// outcome label value, via a real Gather so it reflects exactly what a
// scrape would see. Deliberately avoids importing client_model directly to
// do this: only values Gather itself returns are inspected, their concrete
// type never named here, the same way instance_test.go.tmpl's seriesFor
// stays import-free elsewhere in this scaffold.
func requestWaitSampleCount(t *testing.T, outcome string) uint64 {
	t.Helper()
	reg := prometheus.NewRegistry()
	if err := reg.Register(RequestWait); err != nil {
		t.Fatalf("register RequestWait: %v", err)
	}
	mfs, err := reg.Gather()
	if err != nil {
		t.Fatalf("gather: %v", err)
	}
	for _, mf := range mfs {
		if mf.GetName() != "@@NAMESPACE@@_exporter_request_wait_seconds" {
			continue
		}
		for _, m := range mf.GetMetric() {
			for _, l := range m.GetLabel() {
				if l.GetName() == "outcome" && l.GetValue() == outcome {
					return m.GetHistogram().GetSampleCount()
				}
			}
		}
	}
	t.Fatalf(`no outcome=%q series found for RequestWait; init() must pre-populate both outcome values`, outcome)
	return 0
}

// TestAcquireLabelsRequestWaitByOutcome proves the outcome label actually
// discriminates between Acquire's two paths, not just that RequestWait gets
// observed at all: a granted acquire must bump "success" and leave "error"
// untouched, and a ctx-expired acquire must do the opposite. Guards against
// the Help text being truthful ("...by outcome.") while the series itself
// still conflated both outcomes into one bucket.
func TestAcquireLabelsRequestWaitByOutcome(t *testing.T) {
	beforeSuccess := requestWaitSampleCount(t, "success")
	beforeError := requestWaitSampleCount(t, "error")

	l := NewLimiter(1)
	release, err := l.Acquire(context.Background())
	if err != nil {
		t.Fatalf("acquire a free slot: %v", err)
	}
	defer release()

	if got, want := requestWaitSampleCount(t, "success"), beforeSuccess+1; got != want {
		t.Fatalf(`RequestWait outcome="success" sample count = %d, want %d after a granted acquire`, got, want)
	}
	if got := requestWaitSampleCount(t, "error"); got != beforeError {
		t.Fatalf(`RequestWait outcome="error" sample count changed to %d (want unchanged at %d) on a granted acquire`, got, beforeError)
	}

	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
	defer cancel()
	if _, err := l.Acquire(ctx); err == nil {
		t.Fatal("Acquire on an expired context, with the only slot already held, returned no error")
	}

	if got, want := requestWaitSampleCount(t, "error"), beforeError+1; got != want {
		t.Fatalf(`RequestWait outcome="error" sample count = %d, want %d after a ctx-expired acquire`, got, want)
	}
	if got, want := requestWaitSampleCount(t, "success"), beforeSuccess+1; got != want {
		t.Fatalf(`RequestWait outcome="success" sample count changed to %d (want unchanged at %d) on a ctx-expired acquire`, got, want)
	}
}

// requestWaitSampleSum reads the observed SECONDS, not the sample count, which
// is what makes it possible to assert that the histogram brackets the wait
// alone. Same gather-into-a-throwaway-registry shape as its sibling above.
func requestWaitSampleSum(t *testing.T, outcome string) float64 {
	t.Helper()
	reg := prometheus.NewRegistry()
	if err := reg.Register(RequestWait); err != nil {
		t.Fatalf("register RequestWait: %v", err)
	}
	mfs, err := reg.Gather()
	if err != nil {
		t.Fatalf("gather: %v", err)
	}
	for _, mf := range mfs {
		if mf.GetName() != "@@NAMESPACE@@_exporter_request_wait_seconds" {
			continue
		}
		for _, m := range mf.GetMetric() {
			for _, l := range m.GetLabel() {
				if l.GetName() == "outcome" && l.GetValue() == outcome {
					return m.GetHistogram().GetSampleSum()
				}
			}
		}
	}
	t.Fatalf(`no @@NAMESPACE@@_exporter_request_wait_seconds series with outcome=%q`, outcome)
	return 0
}

// TestRequestWaitMeasuresTheWaitAlone pins what the metric's own name claims,
// which nothing asserted before: its sibling above counts samples by outcome
// and would stay green if the histogram bracketed the wait AND the request.
//
// This matters more now that the wait has a budget of its own and can be far
// longer than a request: an operator sizing --exporter.max-request-wait reads
// this histogram to decide, so a value that quietly included request time
// would drive that decision wrong, and would do it invisibly, since both
// numbers move together under load.
func TestRequestWaitMeasuresTheWaitAlone(t *testing.T) {
	const (
		holdSlot   = 300 * time.Millisecond
		serverWork = 400 * time.Millisecond // deliberately larger than the wait
	)

	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		time.Sleep(serverWork)
		_, _ = w.Write([]byte("ok"))
	}))
	defer srv.Close()

	before := requestWaitSampleSum(t, "success")

	lim := NewLimiter(1)
	c := NewClientOn(NewTransport(&http.Client{}), srv.URL, 5*time.Second).
		WithLimiter(lim).
		WithAcquireTimeout(5 * time.Second)

	release, err := lim.Acquire(context.Background())
	if err != nil {
		t.Fatalf("seeding the limiter: %v", err)
	}
	go func() {
		time.Sleep(holdSlot)
		release()
	}()

	if _, err := c.Fetch(context.Background(), "/"); err != nil {
		t.Fatalf("Fetch: %v", err)
	}

	// Two observations landed on outcome="success": the seeding Acquire above
	// (immediate, near zero) and Fetch's own (about holdSlot). So the delta is
	// about holdSlot, and it must NOT have grown by serverWork on top.
	delta := requestWaitSampleSum(t, "success") - before
	if delta < holdSlot.Seconds()*0.5 {
		t.Fatalf("observed wait total grew by only %.3fs, less than half the %v the slot was held: the histogram is not bracketing the wait at all", delta, holdSlot)
	}
	if ceiling := (holdSlot + serverWork/2).Seconds(); delta > ceiling {
		t.Fatalf("observed wait total grew by %.3fs, past %.3fs: request time is leaking into a histogram that claims to measure the wait for a slot", delta, ceiling)
	}
}

// TestLimiterSetGroupsByTarget proves two collectors on the same address share
// one ceiling and two collectors on different addresses do not.
func TestLimiterSetGroupsByTarget(t *testing.T) {
	s := NewLimiterSet(4)
	// Two separate calls, each stored before comparing: calling For twice
	// inline on the same line (s.For(x) != s.For(x)) reads to staticcheck's
	// SA4000 as comparing an expression to itself, a false positive here
	// since For is stateful, but named variables sidestep the false alarm
	// the same way TestNewClientForSharesOneTransport's a.tr.Get() !=
	// b.tr.Get() already does elsewhere in this package.
	first := s.For("http://a.example")
	second := s.For("http://a.example")
	if first != second {
		t.Fatal("LimiterSet handed out two limiters for one target")
	}
	if s.For("http://a.example") == s.For("http://b.example") {
		t.Fatal("LimiterSet shared one limiter across two targets")
	}
	if NewLimiterSet(0).For("http://a.example") != nil {
		t.Fatal("a LimiterSet built with ceiling 0 handed out a non-nil limiter")
	}
}

// TestFetchGivesTheRequestItsOwnBudgetAfterWaiting pins one property, and it
// is worth being exact about which: the wait for a slot and the request that
// follows it get SEPARATE budgets. A collector that spends most of its wait
// budget queued still gets its full request deadline once the slot is granted,
// instead of inheriting whatever a single shared deadline had left and failing
// on a request it never had time to finish.
//
// It does NOT test that a low ceiling stops starving collectors, and no test
// here does, because the code does not do that yet: acquireTimeout still
// defaults to the request timeout, so the same collectors miss out at a
// ceiling of 1: they fail on the wait rather than mid-request. Sizing the wait
// budget independently is what would change the count, and that is a separate
// change.
//
// Timings are deliberately coarse (hundreds of milliseconds; 100ms of slack on
// the wait side, 150ms on the request side) so this asserts an ordering rather
// than a stopwatch reading.
func TestFetchGivesTheRequestItsOwnBudgetAfterWaiting(t *testing.T) {
	const (
		timeout    = 400 * time.Millisecond
		holdSlot   = 300 * time.Millisecond
		serverWork = 250 * time.Millisecond
	)

	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		time.Sleep(serverWork)
		_, _ = w.Write([]byte("ok"))
	}))
	defer srv.Close()

	// NewClientOn is the multi-instance construction path: the deadline cannot
	// live on the shared http.Client, so it lives on the Client and Fetch
	// applies it. That is the path where a single shared deadline used to cover
	// the wait and the request together.
	tr := NewTransport(&http.Client{})
	lim := NewLimiter(1)
	c := NewClientOn(tr, srv.URL, timeout).WithLimiter(lim)

	// Occupy the only slot, then free it after most of the wait budget has been
	// spent. Acquired directly rather than through a second Fetch so the test
	// controls exactly when the slot is released.
	release, err := lim.Acquire(context.Background())
	if err != nil {
		t.Fatalf("seeding the limiter: %v", err)
	}
	go func() {
		time.Sleep(holdSlot)
		release()
	}()

	// holdSlot + serverWork exceeds timeout, so this call can only succeed if
	// the request deadline starts when the slot is granted. Sharing one budget
	// leaves 100ms for 250ms of work: "context deadline exceeded".
	if _, err := c.Fetch(context.Background(), "/"); err != nil {
		t.Fatalf("Fetch after a %v queue wait: %v; the request must get its own %v, not the remainder of a budget the wait already spent", holdSlot, err, timeout)
	}
}

// TestFetchFailsFastWhenTheQueueBudgetExpires pins the bound on the wait
// itself: a collector that never gets a slot fails on the WAIT, quickly and
// with a message naming it, rather than blocking forever or proceeding to a
// request it has no time left to finish.
//
// Honest about its own reach: this one passes with the pre-fix ordering too,
// since a shared deadline also bounded the wait. It does not guard the
// reordering (its sibling above does that); it guards against the wait losing
// its bound altogether, which is the failure the boot-time check in
// wiring/client_build.frag exists to prevent and which would otherwise show up
// as a hung package rather than a red test.
func TestFetchFailsFastWhenTheQueueBudgetExpires(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		_, _ = w.Write([]byte("ok"))
	}))
	defer srv.Close()

	tr := NewTransport(&http.Client{})
	lim := NewLimiter(1)
	c := NewClientOn(tr, srv.URL, 100*time.Millisecond).WithLimiter(lim)

	// Held for the whole test: nothing ever frees this slot.
	if _, err := lim.Acquire(context.Background()); err != nil {
		t.Fatalf("seeding the limiter: %v", err)
	}

	start := time.Now()
	_, err := c.Fetch(context.Background(), "/")
	if err == nil {
		t.Fatal("Fetch succeeded with no slot ever released; the wait must be bounded")
	}
	if !strings.Contains(err.Error(), "wait for a request slot") {
		t.Fatalf("Fetch failed with %v; the error must name the wait, not the request", err)
	}
	if elapsed := time.Since(start); elapsed > time.Second {
		t.Fatalf("Fetch took %v to give up on an unwinnable slot; the wait budget must bound it", elapsed)
	}
}
