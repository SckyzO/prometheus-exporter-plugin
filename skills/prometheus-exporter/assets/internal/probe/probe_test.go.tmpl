func TestMissingTargetRejected(t *testing.T) {
	f := &recordingFactory{}
	rec := serve(newTestHandler(f, nil), "/probe")
	if rec.Code != http.StatusBadRequest {
		t.Fatalf("missing target: got %d, want 400", rec.Code)
