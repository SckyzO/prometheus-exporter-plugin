# @@EXPORTER_NAME@@ — example compose file for the minimal image (Dockerfile.minimal).
#
# Same hardening as docker-compose.yml (no-new-privileges, all capabilities
# dropped, read-only root filesystem, tmpfs /tmp). The minimal image adds to
# that: no shell, no package manager, and it always runs as the distroless
# nonroot user regardless of anything set here.
#
# container_name below has a "-minimal" suffix so this stack never collides
# with docker-compose.yml's — the two CAN run at the same time. They still
# default to the SAME host port (@@DEFAULT_PORT@@) though, so to run this
# ALONGSIDE the standard stack (e.g. `make docker-run` followed by
# `make docker-run-minimal`), give this one a free port first:
#
#   HOST_PORT=<free-port> make docker-run-minimal
#
# Environment overrides:
#
#   IMAGE       image to run                   default: @@EXPORTER_NAME@@:dev-minimal
#   HOST_PORT   host-side port for /metrics    default: @@DEFAULT_PORT@@

services:
  @@EXPORTER_NAME@@:
    image: ${IMAGE:-@@EXPORTER_NAME@@:dev-minimal}
    container_name: @@EXPORTER_NAME@@-minimal
    restart: unless-stopped
    ports:
      - "${HOST_PORT:-@@DEFAULT_PORT@@}:@@DEFAULT_PORT@@"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    command:
      - --web.listen-address=:@@DEFAULT_PORT@@
      - --log.level=info
