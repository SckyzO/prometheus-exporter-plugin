# @@EXPORTER_NAME@@: example compose file for the standard image (Dockerfile).
#
# Hardened by default:
#   - no-new-privileges: the container can never gain more privileges than
#     it started with (e.g. via a setuid/setgid binary).
#   - every Linux capability dropped - this exporter needs none of them.
#   - the root filesystem is read-only - a stateless HTTP exporter has no
#     legitimate reason to write anywhere.
#   - /tmp is a small in-memory tmpfs, for the rare case something still
#     wants a writable path (e.g. a library that insists on a temp file).
#
# Environment overrides:
#
#   IMAGE       image to run                   default: @@EXPORTER_NAME@@:dev
#   HOST_PORT   host-side port for /metrics    default: @@DEFAULT_PORT@@

services:
  @@EXPORTER_NAME@@:
    image: ${IMAGE:-@@EXPORTER_NAME@@:dev}
    container_name: @@EXPORTER_NAME@@
    restart: unless-stopped
    ports:
      - "${HOST_PORT:-@@DEFAULT_PORT@@}:@@DEFAULT_PORT@@"
    # @@IF flavor=cli@@
    # If this exporter's collectors shell out to an external
    # CLI tool, mount it (and any config/socket it needs) read-only here,
    # e.g.:
    # volumes:
    #   - /path/on/host/to/tool:/usr/local/bin/tool:ro
    # @@ENDIF@@
    @@IF target-model=multi-instance@@
    # This target model reads the list of instances it watches from
    # --config.file and refuses to start without it, so the file is mounted
    # rather than offered as an option. Create it before the first `up`:
    #
    #   cp config.example.yml config.yml   # then edit its instances: block
    #
    # If it does not exist, Docker creates a DIRECTORY at that path instead of
    # failing, and the exporter then reports a confusing read error on
    # something that is not a file. Point CONFIG_FILE elsewhere to override.
    #
    # Read-only because the exporter only ever reads it; reload in place with
    # `docker compose kill -s HUP @@EXPORTER_NAME@@` after editing, no restart.
    volumes:
      - ${CONFIG_FILE:-./config.yml}:/etc/@@EXPORTER_NAME@@/config.yml:ro
    @@ENDIF@@
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    command:
      - --web.listen-address=:@@DEFAULT_PORT@@
      @@IF target-model=multi-instance@@
      - --config.file=/etc/@@EXPORTER_NAME@@/config.yml
      @@ENDIF@@
      - --log.level=info
